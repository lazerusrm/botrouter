{
  "name": "grok-bot-setup",
  "version": "1.3.0",
  "description": "BotRouter runtime: route Grok Bot across subscription and API model providers with reliable native tools",
  "keywords": [
    "grok",
    "xai",
    "adapters",
    "cli",
    "llm",
    "openai-compatible"
  ],
  "homepage": "https://github.com/lazerusrm/botrouter",
  "bugs": {
    "url": "https://github.com/lazerusrm/botrouter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazerusrm/botrouter.git"
  },
  "license": "MIT",
  "author": "lazerusrm",
  "type": "commonjs",
  "bin": {
    "adapters": "adapters.sh",
    "grok-bot-setup": "adapters.sh"
  },
  "files": [
    "adapters",
    "adapters.sh",
    "xai-prompt-session.cjs",
    "xai-inference.env.example",
    "scripts/ensure-xai-inference.sh",
    "scripts/restore-after-reset.sh",
    "scripts/bootstrap.sh",
    "examples/cliproxy-openai-compat.yaml",
    "docs/GUIDE_CUSTOM_INFERENCE.md",
    "docs/SHAREABLE_OPERATOR_PLUGIN.md",
    "INSTALL_WITH_YOUR_BOT.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "plugins/botrouter",
    ".agents/plugins/marketplace.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=14"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "preferGlobal": true,
  "scripts": {
    "adapters": "bash ./adapters.sh",
    "prepack": "test -x adapters.sh",
    "test": "bash -n adapters.sh && bash -n adapters && bash -n scripts/ensure-xai-inference.sh && bash -n scripts/restore-after-reset.sh && bash -n scripts/bootstrap.sh && bash ./adapters.sh help >/dev/null"
  }
}
